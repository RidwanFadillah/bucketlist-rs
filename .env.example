# ==========================================================
# DUOVENTURE - VERCEL & PRODUCTION ENVIRONMENT VARIABLES
# ==========================================================
# Saat deploy ke Vercel (https://vercel.com):
# Masukkan variable berikut di Project Settings > Environment Variables:

# 1. Web App URL dari Google Apps Script Anda (Database Cloud Spreadsheet)
VITE_GOOGLE_SHEET_URL=https://script.google.com/macros/s/AKfycbz-IUnwKQ-lm_4mGeAVDo72mGkoKNbnhjMVl3pQtBv9CytFnZoVQlvB2OtBRWC8deg/exec

# 2. Cloudinary Storage untuk Foto & Struk di Vercel (100% Gratis - 25GB)
# Daftar di https://cloudinary.com lalu buat unsigned upload preset:
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
